          />
          <Select
            label="استان"
            placeholder="انتخاب استان..."
            options={provinceSelectOptions}
            value={form.province}
            onChange={(e) => setForm((p) => ({ ...p, province: e.target.value }))}
            required
          />
          {/* ✅ checked is always boolean */}
          <Toggle
            checked={form.is_active}
            onChange={(v) => setForm((p) => ({ ...p, is_active: v }))}
            label="شهر فعال باشد"
          />
        </div>
      </Modal>
    </div>
  );
}
