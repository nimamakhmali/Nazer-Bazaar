        if self.request.method == 'GET':
            return [IsAuthenticated()]
        return [CanManageStore()]

    @extend_schema(
        summary='پروانه کسب فروشگاه',
        tags=['stores'],
        responses={200: StoreLicenseSerializer}
    )
