        null=True,
        blank=True,
        verbose_name='سال تأسیس'
    )
    is_active = models.BooleanField(
        default=True,
        verbose_name='فعال',
        db_index=True
    )

    class Meta:
        db_table = 'organizations_chamber'
        verbose_name = 'اتاق اصناف'
        verbose_name_plural = 'اتاق‌های اصناف'
