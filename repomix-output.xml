  updateCategory: (id: number, data: unknown) =>
    apiClient.patch(ENDPOINTS.PRODUCTS.CATEGORY(id), data),

  getUnits: () =>
    apiClient.get(ENDPOINTS.PRODUCTS.UNITS),

  exportProducts: (params?: Record<string, unknown>) =>
