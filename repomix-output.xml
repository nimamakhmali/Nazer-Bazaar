            description="اگر از قیمت‌گذاری فروشگاهی ناراضی هستید، شکایت ثبت کنید."
            action={
              <Link href="/complaints/new">
                <Button
                  size="sm"
                  leftIcon={<PlusCircleIcon className="h-4 w-4" />}
