<file path="frontend/src/app/globals.css">
@import "tailwindcss";

/* ============================================================
   تعریف تم رنگی سامانه پایش قیمت کالا
   Tailwind CSS v4 - CSS-first configuration
   ============================================================ */

@theme {
  /* رنگ اصلی - سرمه‌ای عمیق */
  --color-primary-50:  #eef3fa;
  --color-primary-100: #d5e0f0;
  --color-primary-200: #aac1e1;
  --color-primary-300: #7ea2d2;
  --color-primary-400: #5383c3;
  --color-primary-500: #2e6db4;
  --color-primary-600: #1b3a6b;
  --color-primary-700: #0f2347;
  --color-primary-800: #071524;
  --color-primary-900: #030a11;

  /* رنگ ثانویه - طلایی گرم */
  --color-secondary-50:  #fdf8ec;
  --color-secondary-100: #faf0d0;
  --color-secondary-200: #f5e0a1;
  --color-secondary-300: #efcf71;
  --color-secondary-400: #e9bf42;
  --color-secondary-500: #deb94a;
  --color-secondary-600: #c49a2e;
  --color-secondary-700: #9e7a1f;
  --color-secondary-800: #785b17;
  --color-secondary-900: #523d0f;

  /* رنگ‌های وضعیت */
  --color-success-light:   #22a160;
  --color-success-DEFAULT: #1a7a4a;
  --color-success-dark:    #115233;

  --color-danger-light:   #e74c3c;
  --color-danger-DEFAULT: #c0392b;
  --color-danger-dark:    #922b21;

  --color-warning-light:   #f59e0b;
  --color-warning-DEFAULT: #d97706;
  --color-warning-dark:    #b45309;

  /* رنگ‌های پایه */
  --color-background: #f4f6f9;
  --color-surface:    #ffffff;
  --color-muted:      #64748b;
  --color-border:     #e2e8f0;

  /* فونت */
  --font-family-sans: "Vazirmatn", "Tahoma", sans-serif;

  /* سایه‌ها */
  --shadow-card:       0 1px 3px 0 rgb(27 58 107 / 0.08), 0 1px 2px 0 rgb(27 58 107 / 0.04);
  --shadow-card-hover: 0 4px 6px -1px rgb(27 58 107 / 0.1), 0 2px 4px -1px rgb(27 58 107 / 0.06);
  --shadow-header:     0 2px 8px rgb(27 58 107 / 0.08);
  --shadow-sidebar:    2px 0 8px rgb(27 58 107 / 0.08);

  /* border radius */
  --radius-xl:  0.75rem;
  --radius-2xl: 1rem;
  --radius-3xl: 1.5rem;

  /* انیمیشن */
  --animate-fade-in:  fade-in 0.2s ease-in-out;
  --animate-slide-in: slide-in 0.3s ease-out;
}

/* ============================================================
   Keyframes
   ============================================================ */
@keyframes fade-in {
  from { opacity: 0; transform: translateY(-4px); }
  to   { opacity: 1; transform: translateY(0); }
}

@keyframes slide-in {
  from { opacity: 0; transform: translateX(16px); }
  to   { opacity: 1; transform: translateX(0); }
}

/* ============================================================
   Base Styles
   ============================================================ */
@layer base {
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    direction: rtl;
    font-family: var(--font-family-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    background-color: var(--color-background);
    color: #1e293b;
    line-height: 1.6;
  }

  h1, h2, h3, h4, h5, h6 {
    font-weight: 700;
    color: var(--color-primary-600);
    line-height: 1.3;
  }

  /* اسکرول بار */
  ::-webkit-scrollbar {
    width: 6px;
    height: 6px;
  }
  ::-webkit-scrollbar-track {
    background: #f1f5f9;
  }
  ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 3px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #94a3b8;
  }

  /* Focus visible */
  :focus-visible {
    outline: 2px solid var(--color-primary-500);
    outline-offset: 2px;
  }

  /* Selection */
  ::selection {
    background-color: var(--color-primary-100);
    color: var(--color-primary-700);
  }
}

/* ============================================================
   Component Utilities
   ============================================================ */
@layer utilities {
  /* Card */
  .card {
    background-color: #ffffff;
    border-radius: 0.75rem;
    border: 1px solid #f1f5f9;
    box-shadow: var(--shadow-card);
  }

  .card-hover {
    background-color: #ffffff;
    border-radius: 0.75rem;
    border: 1px solid #f1f5f9;
    box-shadow: var(--shadow-card);
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .card-hover:hover {
    box-shadow: var(--shadow-card-hover);
    border-color: #e2e8f0;
  }

  /* Buttons */
  .btn-primary {
    background-color: var(--color-primary-600);
    color: #ffffff;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    transition: background-color 0.2s ease, box-shadow 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-700);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.1);
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-secondary {
    background-color: var(--color-secondary-600);
    color: #ffffff;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 1px solid transparent;
    transition: background-color 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .btn-secondary:hover {
    background-color: var(--color-secondary-700);
  }

  .btn-outline {
    background-color: transparent;
    color: var(--color-primary-600);
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
    border: 2px solid var(--color-primary-600);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .btn-outline:hover {
    background-color: var(--color-primary-600);
    color: #ffffff;
  }

  /* Typography utilities */
  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary-700);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .page-subtitle {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: 1.5rem;
  }

  /* Badge utilities */
  .badge-success {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    background-color: #f0fdf4;
    color: #166534;
    border: 1px solid #bbf7d0;
  }

  .badge-danger {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    background-color: #fef2f2;
    color: #991b1b;
    border: 1px solid #fecaca;
  }

  .badge-warning {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    background-color: #fffbeb;
    color: #92400e;
    border: 1px solid #fde68a;
  }

  .badge-info {
    display: inline-flex;
    align-items: center;
    padding: 0.125rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    background-color: #eff6ff;
    color: #1e40af;
    border: 1px solid #bfdbfe;
  }

  /* Input base */
  .input-base {
    width: 100%;
    border: 1px solid #cbd5e1;
    border-radius: 0.5rem;
    padding: 0.625rem 0.75rem;
    font-size: 0.875rem;
    color: #1e293b;
    background-color: #ffffff;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
    outline: none;
  }

  .input-base:focus {
    border-color: var(--color-primary-500);
    box-shadow: 0 0 0 3px rgb(46 109 180 / 0.1);
  }

  .input-base::placeholder {
    color: #94a3b8;
  }

  /* Table */
  .table-header {
    background-color: #f8fafc;
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .table-row {
    border-bottom: 1px solid #f8fafc;
    transition: background-color 0.1s ease;
  }

  .table-row:hover {
    background-color: #f8fafc;
  }

  /* Section divider */
  .section-divider {
    border-top: 1px solid #f1f5f9;
    margin: 1.5rem 0;
  }

  /* Animate utilities */
  .animate-fade-in {
    animation: var(--animate-fade-in);
  }

  .animate-slide-in {
    animation: var(--animate-slide-in);
  }

  /* Shadow utilities */
  .shadow-card {
    box-shadow: var(--shadow-card);
  }

  .shadow-card-hover {
    box-shadow: var(--shadow-card-hover);
  }

  .shadow-header {
    box-shadow: var(--shadow-header);
  }

  .shadow-sidebar {
    box-shadow: var(--shadow-sidebar);
  }

  /* RTL helpers */
  .rtl {
    direction: rtl;
  }

  /* Truncate multi-line */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
}
