      </div>

      {/* ── Navigation ───────────────────────────────────── */}
      <nav className="flex-1 overflow-y-auto py-4 px-2 space-y-1 scrollbar-thin">
        {groups.map((group, gi) => (
          <div key={gi} className={gi > 0 ? "mt-3" : ""}>
            {/* Group title */}
            {group.title && !isCollapsed && (
              <p
