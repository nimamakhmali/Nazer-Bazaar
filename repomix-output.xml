          </div>
        )}

        {/* Toggle button */}
        <button
          onClick={toggleSidebar}
          className={cn(
            "flex-shrink-0 p-1.5 rounded-lg transition-colors",
            "text-slate-500 hover:text-slate-300 hover:bg-white/5",
            isCollapsed && "hidden"
          )}
          aria-label="بستن منو"
        >
          <ChevronLeftIcon className="h-4 w-4" />
