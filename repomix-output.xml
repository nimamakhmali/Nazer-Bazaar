                </span>
              </Link>
            </div>
          )}
        </div>
      </header>

      {/* ── Content ── */}
      <main className="flex-1">{children}</main>

      {/* ── Footer ── */}
      <footer
        className="py-8 text-center"
        style={{ backgroundColor: "#0F2347" }}
      >
        <p className="text-sm" style={{ color: "rgba(255,255,255,0.4)" }}>
