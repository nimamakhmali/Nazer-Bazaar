                      <td className="px-5 py-4 text-slate-600">{city.province_name}</td>
                      <td className="px-5 py-4">
                        <span className="font-mono text-xs bg-slate-100 text-slate-500
                                         px-2 py-0.5 rounded-lg">
                          {city.province_code}
