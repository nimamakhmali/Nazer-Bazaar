  name:                     string;
  union:                    number;
  union_name:               string;
  city_name:                string;
  province_name:            string;
  owner:                    number;
  owner_name:               string;
  owner_phone:              string;
  license_number:           string;
  phone:                    string;
  mobile:                   string;
  address:                  string;
  postal_code:              string;
  description:              string;
  status:                   string;
  status_display:           string;
  can_set_price:            boolean;
  is_active:                boolean;
  complaints_count:         number;
  pending_complaints_count: number;
  rejection_reason:         string | null;
  status_changed_at:        string | null;
  created_at:               string;
  updated_at:               string;
}

interface EditForm {
