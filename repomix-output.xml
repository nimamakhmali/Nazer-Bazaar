    )
    expire_date = models.DateField(
        verbose_name='تاریخ انقضا'
    )
    issuing_authority = models.CharField(
        max_length=200,
        verbose_name='مرجع صادرکننده',
        help_text='مثال: اتاق اصناف شهر تهران'
    )
