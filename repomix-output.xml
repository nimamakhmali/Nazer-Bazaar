            union_id=union_id,
            manager_id=serializer.validated_data['manager_id'],
            requesting_user=request.user
        )

        return Response({
            'success': True,
            'message': 'رئیس اتحادیه با موفقیت تعیین شد',
            'data': UnionDetailSerializer(updated).data
        })
