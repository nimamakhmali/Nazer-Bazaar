@admin.register(Store)
class StoreAdmin(admin.ModelAdmin):
    list_display = [
        'name',
        'union',
        'city_name',
        'owner',
        'license_number',
        'status_badge',
        'is_active',
        'created_at',
    ]
    list_filter = [
        'status',
        'is_active',
        'union__chamber__city__province',
        'union__chamber__city',
        'union',
    ]
    search_fields = [
        'name',
        'license_number',
        'address',
        'owner__first_name',
        'owner__last_name',
        'owner__phone_number',
    ]
    list_editable = ['is_active']
    readonly_fields = [
        'created_at',
        'updated_at',
        'status_changed_at',
        'store_image_preview',
        'complaints_count',
    ]
