# ═══════════════════════════════════════════════════════════
# General
# ═══════════════════════════════════════════════════════════
COMPOSE_PROJECT_NAME=pricemonitor

# پورتی که روی سرور expose میشه - چون سرور مشترک است
# پورتی انتخاب کنید که با پروژه‌های دیگر تداخل نداشته باشد
NGINX_PORT=8080

# ═══════════════════════════════════════════════════════════
# PostgreSQL
# ═══════════════════════════════════════════════════════════
DB_ENGINE=django.db.backends.postgresql
DB_NAME=price_monitoring
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# ═══════════════════════════════════════════════════════════
# Redis
# ═══════════════════════════════════════════════════════════
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ═══════════════════════════════════════════════════════════
# Django
# ═══════════════════════════════════════════════════════════
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=CHANGE_ME_GENERATE_A_REAL_50_CHAR_SECRET_KEY
DEBUG=False

# آی‌پی سرور parspack خودتون رو جایگزین کنید
ALLOWED_HOSTS=YOUR_SERVER_IP,localhost,backend

CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP:8080
CSRF_TRUSTED_ORIGINS=http://YOUR_SERVER_IP:8080

# چون فعلا SSL/دامنه نداریم، این‌ها باید False باشند
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ═══════════════════════════════════════════════════════════
# Email
# ═══════════════════════════════════════════════════════════
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ═══════════════════════════════════════════════════════════
# SMS (Kavenegar)
# ═══════════════════════════════════════════════════════════
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ═══════════════════════════════════════════════════════════
# App Config
# ═══════════════════════════════════════════════════════════
OTP_EXPIRE_SECONDS=120
OTP_LENGTH=6
MAX_LOGIN_ATTEMPTS=5

# ═══════════════════════════════════════════════════════════
# Superuser خودکار (اختیاری - اگر خالی بمونه رد میشه)
# ═══════════════════════════════════════════════════════════
DJANGO_SUPERUSER_PHONE_NUMBER=
DJANGO_SUPERUSER_PASSWORD=

# ═══════════════════════════════════════════════════════════
# Frontend (Build-time - در image فرانت inline میشوند)
# ═══════════════════════════════════════════════════════════
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:8080/api/v1
NEXT_PUBLIC_APP_NAME=سامانه پایش قیمت کالا
NEXT_PUBLIC_APP_VERSION=1.0.0