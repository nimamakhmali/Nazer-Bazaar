# ─────────────────────────────────────────────────────────────
# فایل: .env  (در root پروژه، کنار docker-compose.yml)
# ─────────────────────────────────────────────────────────────

# ─── Nginx ──────────────────────────────────────────────────
NGINX_PORT=8090

# ─── Django ─────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=change-this-to-a-very-long-random-string-in-production-min-50-chars
DEBUG=False
ALLOWED_HOSTS=171.22.24.139,localhost,127.0.0.1

# ─── Database ───────────────────────────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=pricemonitor_db
DB_USER=pricemonitor_user
DB_PASSWORD=Str0ng_DB_P@ssw0rd_2026
DB_HOST=db
DB_PORT=5432

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ─── Email (اختیاری - برای تست غیرفعال) ───────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ─── SMS (اختیاری) ──────────────────────────────────────────
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=

# ─── Storage ────────────────────────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ─── Security ───────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://171.22.24.139:8090
CSRF_TRUSTED_ORIGINS=http://171.22.24.139:8090
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ─── Superuser (ساخت خودکار) ────────────────────────────────
DJANGO_SUPERUSER_PHONE_NUMBER=09000000000
DJANGO_SUPERUSER_PASSWORD=Admin@12345678

# ─── App Config ─────────────────────────────────────────────
OTP_EXPIRE_SECONDS=120
OTP_LENGTH=6
MAX_LOGIN_ATTEMPTS=5

# ─── Next.js ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://171.22.24.139:8090/api/v1
NEXT_PUBLIC_APP_NAME=سامانه پایش قیمت کالا
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Sentry (اختیاری) ───────────────────────────────────────
SENTRY_DSN=